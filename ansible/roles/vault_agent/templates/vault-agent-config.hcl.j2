{% for cert in vault_agent_certificates -%}
{% if cert.paired | default(false) | bool %}

template {
  source      = "/etc/vault-agent.d/templates/{{ cert.name }}.paired.tpl"
  destination = "{{ cert.cache_path | default('/etc/' ~ cert.product ~ '.d/tls/' ~ cert.name ~ '-rendered.pem') }}"
  perms       = "0600"
  exec {
    command = {{ cert.command.split() | to_json }}
  }
}
{% else %}

template {
  source      = "/etc/vault-agent.d/templates/{{ cert.name }}.cert.tpl"
  destination = "/etc/{{ cert.product }}.d/tls/{{ cert.name }}-cert.pem"
  exec {
    command = [
{% for cmd_part in cert.command.split() %}       "{{ cmd_part }}"{{ "," if not loop.last else "" }}
{% endfor %}    ]
  }
}

template {
  source      = "/etc/vault-agent.d/templates/{{ cert.name }}.key.tpl"
  destination = "/etc/{{ cert.product }}.d/tls/{{ cert.name }}-key.pem"
  exec {
    command = [
{% for cmd_part in cert.command.split() %}       "{{ cmd_part }}"{{ "," if not loop.last else "" }}
{% endfor %}    ]
  }
}
{% endif %}
{% endfor %}
