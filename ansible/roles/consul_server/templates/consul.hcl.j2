data_dir = "/opt/consul"

ui_config{
  enabled = true
}

server = true


performance {
  raft_multiplier = 1
}

bind_addr = "{{ ansible_facts['default_ipv4']['address'] }}"
client_addr = "0.0.0.0"
encrypt = "{{ consul_gossip_key }}"

enable_central_service_config = true

connect {
  enabled = true
}

dns_config {
  node_ttl = "5s"
  service_ttl {
    "*" = "5s"
  }
}

retry_join = [
    "192.168.179.100",
    "192.168.179.99",
    "192.168.179.97",
]

addresses {
  http = "127.0.0.1"
}

ports {
  http = 8500
  https = 8501
#  grpc = 8502
  grpc_tls = 8503
}

log_file = "/var/log/consul/consul.log"
log_rotate_max_files = 10



tls {
  defaults {
    ca_path = "/etc/ca"
    cert_file = "/etc/consul.d/tls/consul-server-cert.pem"
    key_file = "/etc/consul.d/tls/consul-server-key.pem"
    verify_incoming = true
    verify_server_hostname = true
    verify_outgoing = true
    tls_min_version = "TLSv1_2"
  }
#  internal_rpc {
#    verify_server_hostname = true
#    verify_incoming = true
#    verify_outgoing = true
#  }
}

#begin acl config#
acl = {
  enabled = true,
  default_policy = "deny",
  enable_token_persistence = true
  policy_ttl = "5s"
  role_ttl = "5s"
  token_ttl = "5s"
  tokens {
    agent = "{{ consul_agent_acl_token }}"
    default = "{{ consul_agent_acl_token }}"
  }
}
#end acl config
